{
 "title": "VoltPath - pipeline SLOs",
 "uid": "voltpath",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Ingest (events/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(ingest_events_total{result=\"accepted\"}[1m]))"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Processed (events/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(processor_events_total{result=\"applied\"}[1m]))"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Consumer lag",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(processor_consumer_lag)"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Ingest\u2192state p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(processor_event_age_seconds_bucket[5m])) by (le))"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Throughput",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(ingest_events_total{result=\"accepted\"}[1m]))",
     "legendFormat": "ingest accepted"
    },
    {
     "refId": "B",
     "expr": "sum(rate(processor_events_total{result=\"applied\"}[1m]))",
     "legendFormat": "processor applied"
    },
    {
     "refId": "C",
     "expr": "sum(rate(ingest_events_total{result=\"rejected\"}[1m]))",
     "legendFormat": "rejected \u2192 DLQ"
    },
    {
     "refId": "D",
     "expr": "sum(rate(ingest_events_total{result=\"duplicate\"}[1m])) + sum(rate(processor_events_total{result=\"duplicate\"}[1m]))",
     "legendFormat": "duplicates dropped"
    },
    {
     "refId": "E",
     "expr": "sum(rate(lake_rows_total[1m]))",
     "legendFormat": "lake rows"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Consumer lag by partition",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "processor_consumer_lag",
     "legendFormat": "p{{partition}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Latency SLOs (p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(processor_event_age_seconds_bucket[5m])) by (le))",
     "legendFormat": "ingest\u2192dashboard"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(processor_alert_latency_seconds_bucket[5m])) by (le))",
     "legendFormat": "event\u2192alert"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.95, sum(rate(api_request_seconds_bucket[5m])) by (le))",
     "legendFormat": "API p95"
    },
    {
     "refId": "D",
     "expr": "histogram_quantile(0.99, sum(rate(api_request_seconds_bucket[5m])) by (le))",
     "legendFormat": "API p99"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Processor phase time",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(processor_phase_seconds_sum[1m])) by (phase)",
     "legendFormat": "{{phase}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Alerts raised",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(processor_alerts_total[5m])) by (type) * 60",
     "legendFormat": "{{type}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Back-pressure & errors",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(ingest_throttled_total[1m]))",
     "legendFormat": "ingest 429"
    },
    {
     "refId": "B",
     "expr": "sum(rate(api_rate_limited_total[1m]))",
     "legendFormat": "API 429"
    },
    {
     "refId": "C",
     "expr": "sum(rate(processor_telemetry_replay_batches_total[5m]))",
     "legendFormat": "replay slow-path"
    }
   ]
  }
 ],
 "tags": [
  "voltpath"
 ]
}