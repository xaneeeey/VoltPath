# Copy to .env for local overrides. Dev/test values only - production secrets come from the
# cloud secret store (see infra/helm/voltpath/values.yaml -> externalSecrets).
ENV=dev
SEED=42
N_VEHICLES=100000
# Demo login password for every seeded test user (admin@acme.test, fleetmanager@acme.test, ...)
SEED_PASSWORD=voltpath-demo
S3_ACCESS_KEY=voltpath
S3_SECRET_KEY=voltpath-secret
LAKE_BUCKET=voltpath-lake
# Simulator aggregate event rate (events/s). 100000 = every vehicle at 1 Hz (see `make load`);
# 20000 keeps a laptop running the whole stack responsive.
SIM_RATE=20000
# Optional: enables the LLM copilot (falls back to a deterministic planner when unset)
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5
